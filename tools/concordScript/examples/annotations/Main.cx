use Concord.CApplication;
use Concord.CCamera;
use Concord.CColor;
use Concord.CObject;
use Concord.CScene;
use Concord.CRender;

@cpp(section=header, include=["vector"], system=true) {
#define CX_DEMO_LIGHTS 4
struct DemoShaderConfig {
    int maxLights = CX_DEMO_LIGHTS;
};
};

@vulkan(section=source, include=["vulkan/vulkan.h"]) {
namespace DemoVulkan {
struct Context {
    VkInstance instance = VK_NULL_HANDLE;
};
}
};

@pass(name="script_probe", phase=after_scene) {
    (void)context;
    return true;
};

@vulkan(section=source) {
using DemoPassCallback = bool (*)(const Concord::VulkanPassContext&, void*);
bool DemoPointerTarget(const Concord::VulkanPassContext&, void*) { return true; }
DemoPassCallback DemoPointer = DemoPointerTarget;
};

@pass(name="script_pointer", callback=DemoPointer, phase=after_scene, order=1);

@shader(name="demo_vertex", stage=vertex, entry="main",
        defines=["CX_DEMO=1"], include_dirs=["."], options=["-g"]) {
#version 460
layout(location = 0) in vec3 position;
void main() { gl_Position = vec4(position, 1.0); }
};

@fragment(name="demo_fragment", path="shaders/demo_fragment.frag") {
#version 460
layout(location = 0) out vec4 color;
void main() { color = vec4(0.1, 0.45, 1.0, 1.0); }
};

@descriptor(set=0, binding=0, type="uniform_buffer")
class DemoMarker {
    pub int value = CX_DEMO_LIGHTS;
};

@entry {
    Concord::Game game;
    Concord::Window window({.title = "ConcordScript @ sandbox",
                            .resolution = {.width = 960, .height = 540}});
    game.AttachWindow(window);
    Concord::Scene scene;
    scene.Spawn<Concord::Object::Camera>({
        .position = {0.0f, 1.5f, -4.0f},
        .target = {0.0f, 0.0f, 0.0f},
    });
    scene.Spawn<Concord::Object::Box>({
        .material = {.albedo = COLOR_RGB(56, 128, 255)},
    });
    game.LoadScene(scene);
    game.Run();
};
