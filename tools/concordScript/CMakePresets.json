{
  "version": 6,
  "configurePresets": [
    {
      "name": "release-preview",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/release-build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CONCORDSCRIPT_RELEASE_VERSION": "0.1.0-preview.1"
      }
    }
  ],
  "buildPresets": [{"name": "release-preview", "configurePreset": "release-preview", "jobs": 4}],
  "testPresets": [{"name": "release-preview", "configurePreset": "release-preview", "output": {"outputOnFailure": true}}]
}
