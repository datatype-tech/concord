// Short-circuit && / ||, unary !, and break / continue.

@cvm(name="mark") {
    print(99);
    return 1;
};

@cvm {
    if (0 && mark()) {
        print(1);
    }
    if (1 || mark()) {
        print(2);
    }
    if (!0 && 1) {
        print(3);
    }
    let n = 0;
    let i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        if (i == 8) {
            break;
        }
        n = n + i;
    }
    print(n);
    return 0;
};
