// Jolt through the CVM C ABI, without opening a window.
//
// Mirrors concord/tests/PhysicsTests.cpp: a crate comes to rest on a floor,
// a static volume stays put, a downward ray and an overlap see the floor,
// and a thrown box actually leaves the ground.

@cvm {
    let scene = concord_scene_new();
    print(concord_add_physics_system());

    concord_spawn_static_body(scene, 0.0, -0.5, 0.0, 8.0, 1.0, 8.0);
    let box = concord_spawn_dynamic_box(scene, 0.0, 4.0, 0.0, 0.5, 0.5, 0.5, 204, 86, 58, 1.0);
    let volume = concord_spawn_static_body(scene, 0.0, 3.0, 4.0, 1.0, 1.0, 1.0);

    for (let i = 0; i < 180; i += 1) {
        concord_physics_step(scene, 1.0 / 60.0);
    }
    let restY = concord_entity_position(box, 1);
    print(restY > 0.1 && restY < 0.55);
    print(abs(concord_entity_velocity(box, 1)) < 0.35);
    print(abs(concord_entity_position(volume, 1) - 3.0) < 0.001);

    concord_spawn_static_body(scene, 8.0, 0.0, 0.0, 4.0, 0.4, 4.0);
    concord_physics_step(scene, 1.0 / 60.0);
    print(concord_raycast(scene, 8.0, 3.0, 0.0, 0.0, -1.0, 0.0, 10.0) != 0);
    let reach = concord_raycast_distance();
    print(reach > 2.6 && reach < 3.1);
    print(concord_overlap_sphere(scene, 8.0, 0.0, 0.0, 2.0) != 0);

    let thrown = concord_spawn_dynamic_box(scene, 0.0, 2.0, 8.0, 0.4, 0.4, 0.4, 62, 122, 196,
                                            1.0);
    concord_physics_step(scene, 1.0 / 60.0);
    print(concord_entity_set_velocity(thrown, 0.0, 6.0, 0.0));
    concord_physics_step(scene, 1.0 / 60.0);
    print(concord_entity_position(thrown, 1) > 2.05);

    print(abs(concord_gravity(scene, 1) + 9.81) < 0.001);
    let walker = concord_spawn_box(scene, 0.0, 1.0, 12.0, 0.5, 1.8, 0.5, 255, 255, 255);
    print(concord_entity_add_motor(walker, 0.35, 1.8));
    print(concord_entity_set_wish_velocity(walker, 1.0, 0.0, 0.0));
    print(abs(concord_entity_wish_velocity(walker, 0) - 1.0) < 0.001);

    print(concord_scene_free(scene));
    return 0;
};
