// Scalar maths and a seeded RNG: the pieces a game uses for orbits, aim and
// pickups. Angles are radians; degrees(...) / radians(...) convert.

@cvm {
    print_float(sin(0.0));
    print_float(cos(0.0));
    print_float(sqrt(9.0));
    print_float(abs(-2.5));
    print_float(min(3.0, 1.0));
    print_float(max(3.0, 1.0));
    print_float(clamp(5.0, 0.0, 2.0));
    print_float(lerp(0.0, 10.0, 0.25));
    print_float(degrees(pi()));
    print_float(radians(180.0) / pi());
    print_float(sign(-4.0));
    print_float(floor(2.9));
    print_float(ceil(2.1));
    print(hypot(3.0, 4.0) == 5.0);
    print(iabs(-7));
    print(imin(3, 1));
    print(imax(3, 1));

    sys_random_seed(1);
    let first = sys_random_next();
    sys_random_seed(1);
    print(sys_random_next() == first);
    print(sys_random_float() >= 0.0);
    print(sys_random_float() < 1.0);
    return 0;
};
