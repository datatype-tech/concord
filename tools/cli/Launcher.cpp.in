#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <cstdio>
#include <fstream>
#include <filesystem>
#include <string>

namespace {
constexpr const char* Script = R"CONCORD_PS(@BOOTSTRAP_SCRIPT@)CONCORD_PS";

std::wstring Quote(const std::wstring& value)
{
    std::wstring result = L"\"";
    size_t slashes = 0;
    for (wchar_t ch : value) {
        if (ch == L'\\') { ++slashes; continue; }
        result.append(slashes * (ch == L'"' ? 2 : 1), L'\\');
        slashes = 0;
        if (ch == L'"') result += L'\\';
        result += ch;
    }
    result.append(slashes * 2, L'\\');
    return result + L'"';
}
}

int wmain(int argc, wchar_t** argv)
{
    if (argc < 2 || std::wstring(argv[1]) == L"--help") {
        std::puts("Concord CLI 0.1.0-preview.1 (Windows x64)\n"
            "concord init <directory> [--release v0.1.0-preview.1]\n"
            "concord build <directory> | run <directory> | install | doctor\n"
            "Options: --repo owner/repository, --release tag, --sdk directory, --cache directory\n"
            "Downloads and verifies the SDK and build tools from GitHub Release once.\n"
            "No separately installed compiler, CMake or Ninja required.");
        return 0;
    }
    if (std::wstring(argv[1]) == L"--version") {
        std::puts("concord 0.1.0-preview.1"); return 0;
    }
    wchar_t tempDirectory[MAX_PATH], tempFile[MAX_PATH], systemDirectory[MAX_PATH];
    if (!GetTempPathW(MAX_PATH, tempDirectory) ||
        !GetTempFileNameW(tempDirectory, L"ccf", 0, tempFile) ||
        !GetSystemDirectoryW(systemDirectory, MAX_PATH)) return 1;
    const std::filesystem::path scriptPath = std::wstring(tempFile) + L".ps1";
    DeleteFileW(tempFile);
    std::ofstream output(scriptPath, std::ios::binary);
    output << Script; output.close();
    if (!output) { DeleteFileW(scriptPath.c_str()); return 1; }
    const std::wstring executable = std::wstring(systemDirectory) + L"\\WindowsPowerShell\\v1.0\\powershell.exe";
    std::wstring command = Quote(executable) + L" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File " + Quote(scriptPath.wstring());
    command += L" -Action " + Quote(argv[1]);
    bool projectSeen = false;
    for (int i = 2; i < argc; ++i) {
        std::wstring arg = argv[i];
        std::wstring name;
        if (arg == L"--repo") name = L"Repository";
        else if (arg == L"--release") name = L"Release";
        else if (arg == L"--sdk") name = L"Sdk";
        else if (arg == L"--cache") name = L"Cache";
        if (!name.empty() && i + 1 < argc) {
            command += L" -" + name + L" " + Quote(argv[++i]);
        } else if (arg.rfind(L"-", 0) != 0 && !projectSeen) {
            projectSeen = true; command += L" -Project " + Quote(arg);
        } else {
            std::fputs("concord: invalid argument; run --help\n", stderr);
            DeleteFileW(scriptPath.c_str()); return 1;
        }
    }
    STARTUPINFOW startup{}; startup.cb = sizeof(startup);
    startup.dwFlags = STARTF_USESTDHANDLES;
    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
    startup.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);
    startup.hStdError = GetStdHandle(STD_ERROR_HANDLE);
    PROCESS_INFORMATION process{};
    const BOOL started = CreateProcessW(executable.c_str(), command.data(), nullptr, nullptr,
        TRUE, 0, nullptr, nullptr, &startup, &process);
    DWORD status = 1;
    if (started) {
        WaitForSingleObject(process.hProcess, INFINITE);
        GetExitCodeProcess(process.hProcess, &status);
        CloseHandle(process.hThread); CloseHandle(process.hProcess);
    } else std::fprintf(stderr, "concord: could not start Windows PowerShell (%lu)\n", GetLastError());
    DeleteFileW(scriptPath.c_str());
    return static_cast<int>(status);
}
