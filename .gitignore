# Build trees (anchored to the repo root: unanchored patterns like `build/`
# also match case-insensitively on Windows, which was silently swallowing
# src/3rd/Jolt/Build/ -- the vendored CMake glue ConcordJolt.cmake requires).
/build/
/build-*/
/*-build/
/*-build-*/
/*-build*/
/out/
/cmake-build-*/
/review-build/

# IDE / editor state
.idea/
.vs/
.vscode/
*.user
*.suo

# Compiler / linker intermediates (in case of in-tree builds)
*.obj
*.o
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.a
!lib/*.dll
!lib/*.lib
!lib/*.a
*.spv

# Logs and local diagnostics
*.log
*_out.txt
*_err.txt
